digraph ER {
  graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=0.9, fontname="Helvetica", label="Udoka Specialist Hospital - Entity Relationship Diagram (crow's foot)", labelloc=t, fontsize=20];
